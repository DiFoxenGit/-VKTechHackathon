# Порты на хосте
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Адреса браузерного фронтенда, которым разрешён доступ к API
DESIGNER_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Необязательный общий Bearer-токен для API. Пусто — локальный режим без авторизации
DESIGNER_API_KEY=

# OpenAI-совместимый провайдер. URL включает /v1
# Отбор: Yandex AI Studio — https://ai.api.cloud.yandex.net/v1 (уточняется)
# Топ-10: адрес инференса VK
# Локально: http://localhost:8000/v1 у vLLM
DESIGNER_LLM_BASE_URL=
# Только открытые веса до 35B: gpt-oss-20b, Qwen3-32B и подобные
DESIGNER_LLM_MODEL=
DESIGNER_LLM_API_KEY=

# Сколько раз переспрашивать модель при невалидном ответе и пауза между попытками
DESIGNER_LLM_ATTEMPTS=3
DESIGNER_LLM_RETRY_DELAY=0.4

# Сколько символов источников помещается в окно модели
DESIGNER_CONTEXT_CHARS=24000

# Проверка слайдов по изображению: модель с открытыми весами, умеющая смотреть картинки.
# Пусто — контекстный аудит идёт по тексту.
DESIGNER_VLM_MODEL=
DESIGNER_VLM_BASE_URL=
DESIGNER_VLM_API_KEY=

# Генерация иллюстраций (задача со звёздочкой). Любой сервис с OpenAI-совместимым
# /v1/images/generations: хватает модели, адреса и ключа. Пусто — слайды собираются
# из картинок шаблона и встроенного набора, как раньше.
DESIGNER_IMAGE_MODEL=
DESIGNER_IMAGE_BASE_URL=
DESIGNER_IMAGE_API_KEY=
# Размер холста и сколько картинок рисовать на колоду (каждая — отдельный запрос).
DESIGNER_IMAGE_SIZE=1024x1024
DESIGNER_IMAGE_LIMIT=3

# Swagger и openapi.json: 1 для разработки, 0 на публичном сервере
DESIGNER_DOCS=0
