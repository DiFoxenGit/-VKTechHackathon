              "product",
              "project",
              "initiative"
            ],
            "title": "Purpose",
            "default": "project"
          },
          "language": {
            "type": "string",
            "maxLength": 30,
            "minLength": 2,
            "title": "Language",
            "default": "ru"
          },
          "slide_count": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Slide Count",
            "default": 12
          },
          "content_pack_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Content Pack Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "brief"
        ],
        "title": "Brief"
      },
      "FixRequest": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "issue_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Issue Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "issue_ids"
        ],
        "title": "FixRequest"
      },
