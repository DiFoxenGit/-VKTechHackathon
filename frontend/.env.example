# Адрес API бэкенда вместе с префиксом версии. Без него интерфейс не работает:
# колоду собирает сервис, локального движка в браузере нет.
# Docker Compose: /api/v1 (nginx проксирует на backend)
# Локальная разработка: /api/v1 (vite проксирует на VITE_DEV_API_PROXY)
VITE_API_URL=

# Куда vite проксирует /api в режиме разработки. Прямой запрос браузера на
# чужой хост блокирует политика CORS, поэтому ходим на свой адрес.
VITE_DEV_API_PROXY=http://localhost:8000

# Общий Bearer-токен, если на бэкенде задан DESIGNER_API_KEY
VITE_API_TOKEN=
