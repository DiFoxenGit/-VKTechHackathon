# Public build settings. Model credentials belong only to the backend.
# Docker/root deployment:
VITE_PRESENTATIONS_API_BASE_URL=/api/v1
VITE_APP_BASE_PATH=/
# auto-sell.site deployment uses /presentations/api/v1 and /presentations/.
# Development proxy target (no API keys):
VITE_DEV_API_PROXY=http://127.0.0.1:8000
