# Адрес API бэкенда вместе с префиксом версии.
# Пусто — фронтенд работает в локальном демо-режиме без сервера.
# Docker Compose: /api/v1 (nginx проксирует на backend)
# Локальная разработка: http://localhost:8000/api/v1
VITE_API_URL=

# Общий Bearer-токен, если на бэкенде задан DESIGNER_API_KEY
VITE_API_TOKEN=
