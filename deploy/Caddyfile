# Без домена Caddy отдаёт сервис по IP на 80 порту.
# Появится домен — заменить :80 на example.com, и сертификат выпустится сам.
:80 {
	encode zstd gzip

	# Загрузка шаблонов и контент-пакетов: запас по размеру и времени генерации.
	request_body {
		max_size 64MB
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			transport http {
				read_timeout 360s
				write_timeout 360s
			}
		}
	}

	handle /docs* {
		reverse_proxy backend:8000
	}

	handle /openapi.json {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}

	log {
		output file /var/log/caddy/access.log
		format console
	}
}
