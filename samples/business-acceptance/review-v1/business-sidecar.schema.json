        },
        "missing_periods": {
          "items": {
            "type": "string"
          },
          "title": "Missing Periods",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "role"
      ],
      "title": "ColumnProfile",
      "type": "object"
    },
    "Dataset": {
      "additionalProperties": false,
      "description": "Store this object in full. rows are never slide-sized samples.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/DatasetRef"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "row_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Row Ids",
          "type": "array"
        },
        "context": {
          "default": "",
          "title": "Context",
          "type": "string"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Notice"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "ref",
        "columns",
        "rows",
        "row_ids"
      ],
      "title": "Dataset",
      "type": "object"
    },
    "DatasetRef": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "archive_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archive Path"
        },
        "table": {
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "source_sha256",
        "filename",
        "table"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "DerivedRow": {
      "additionalProperties": false,
      "properties": {
        "derived_row": {
          "minimum": 2,
