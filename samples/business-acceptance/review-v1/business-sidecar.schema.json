          "title": "Normalization",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Column",
      "type": "object"
    },
    "ColumnProfile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "number",
            "date",
            "category",
            "text",
            "empty",
            "ambiguous"
          ],
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "enum": [
            "metric",
            "dimension",
            "time",
            "identifier",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "missing": {
          "default": 0,
          "title": "Missing",
          "type": "integer"
        },
        "distinct": {
          "default": 0,
          "title": "Distinct",
          "type": "integer"
        },
        "outlier_row_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Outlier Row Ids",
          "type": "array"
        },
        "period": {
          "items": {
            "type": "string"
          },
          "title": "Period",
          "type": "array"
        },
        "periodicity": {
          "anyOf": [
