              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "source_sha256",
        "row_ids",
        "column_ids",
        "operation"
      ],
      "title": "Evidence",
      "type": "object"
    },
