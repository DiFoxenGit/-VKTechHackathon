          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Previous",
          "type": "array"
        },
        "year_ago": {
          "default": [
            "2025-07",
            "2025-09"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Year Ago",
          "type": "array"
        },
        "history": {
          "default": [
            "2025-01",
            "2026-09"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "History",
          "type": "array"
        },
        "plan": {
          "default": [
            "2026-01",
            "2026-12"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Plan",
          "type": "array"
        }
      },
      "title": "BusinessPeriods",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "table",
            "line",
            "bar",
            "histogram",
            "pie",
            "scatter",
            "grouped_bar",
            "stacked_bar",
            "kpi"
          ],
          "title": "Kind",
          "type": "string"
        },
        "rank": {
          "maximum": 3,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "reason": {
          "$ref": "#/$defs/Notice"
        }
      },
      "required": [
        "kind",
        "rank",
        "reason"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "normalization": {
          "default": "identity",
          "enum": [
            "identity",
            "excel_percentage_points",
            "excel_day_fraction"
