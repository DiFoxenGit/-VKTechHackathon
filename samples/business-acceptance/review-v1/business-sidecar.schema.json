{
  "$defs": {
    "Analysis": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "title": "Goal",
          "type": "string"
        },
        "task": {
          "enum": [
            "dynamics",
            "comparison",
            "shares",
            "distribution",
            "relationship",
            "reference",
            "summary"
          ],
          "title": "Task",
          "type": "string"
        },
        "dimension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimension"
        },
        "series_dimension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series Dimension"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "aggregation": {
          "title": "Aggregation",
          "type": "string"
        },
        "missing_policy": {
          "const": "preserve_gaps_exclude_from_aggregate",
          "default": "preserve_gaps_exclude_from_aggregate",
          "title": "Missing Policy",
          "type": "string"
        },
        "transformations": {
          "items": {
            "type": "string"
          },
          "title": "Transformations",
          "type": "array"
        }
      },
      "required": [
        "goal",
        "task",
        "aggregation"
      ],
      "title": "Analysis",
      "type": "object"
    },
    "AnalysisRequest": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "default": "",
          "title": "Goal",
          "type": "string"
        },
        "task": {
          "anyOf": [
            {
              "enum": [
                "dynamics",
                "comparison",
                "shares",
                "distribution",
                "relationship",
                "reference",
                "summary"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task"
        },
        "dimension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimension"
        },
        "series_dimension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series Dimension"
        },
        "series_additive": {
          "default": false,
          "title": "Series Additive",
          "type": "boolean"
        },
        "metrics": {
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "aggregation": {
          "default": "sum",
          "enum": [
            "sum",
            "mean",
            "median",
            "count"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "locale": {
          "default": "ru",
          "enum": [
            "ru",
            "en"
          ],
          "title": "Locale",
          "type": "string"
        },
        "bins": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bins"
        },
        "page_size": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "slide_budget": {
          "default": 30,
          "maximum": 30,
          "minimum": 1,
          "title": "Slide Budget",
          "type": "integer"
        },
        "column_types": {
          "additionalProperties": {
            "enum": [
              "number",
              "date",
              "category",
              "text"
            ],
            "type": "string"
          },
          "title": "Column Types",
          "type": "object"
        },
        "number_locale": {
          "anyOf": [
            {
              "enum": [
                "decimal_comma",
                "decimal_point"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number Locale"
        },
        "filters": {
          "additionalProperties": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "title": "Filters",
          "type": "object"
        }
      },
      "title": "AnalysisRequest",
      "type": "object"
    },
    "AnalysisResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "dataset_ref": {
          "$ref": "#/$defs/DatasetRef"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "analysis": {
          "$ref": "#/$defs/Analysis"
        },
        "visualization": {
          "anyOf": [
            {
              "$ref": "#/$defs/Visualization"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data": {
          "$ref": "#/$defs/VisualData"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Facts",
          "type": "array"
        },
        "presentation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Presentation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "ok",
            "warning",
            "refused"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Notice"
          },
          "title": "Warnings",
          "type": "array"
        },
        "refusal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Notice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "dataset_ref",
        "profile",
        "analysis",
        "status"
      ],
      "title": "AnalysisResult",
      "type": "object"
    },
    "BusinessFact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "exact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exact"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "RUB",
            "%",
            "pp"
          ],
          "title": "Unit",
          "type": "string"
        },
        "period": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Period",
          "type": "array"
        },
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "rounding": {
          "title": "Rounding",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        }
      },
      "required": [
        "id",
        "exact",
        "value",
        "unit",
        "period",
        "formula",
        "evidence",
        "rounding"
      ],
      "title": "BusinessFact",
      "type": "object"
    },
    "BusinessPeriods": {
